# ERPNext All-in-One Configuration

# Image & Version
ERPNEXT_VERSION=v16
CUSTOM_IMAGE=amirul123/allinone-erpnext
CUSTOM_TAG=latest

# Site & Domain Configuration
# Target Frappe site name (used for site creation, backups, and app installs)
SITE_NAME=yoursite.local
FRAPPE_SITE_NAME_HEADER=yoursite.local

# Network / Port Mapping
# Host port exposed for web traffic (both CONTAINER_PORT and HTTP_PORT supported)
CONTAINER_PORT=8080
HTTP_PORT=8080

# Database (MariaDB)
# Root password for MariaDB administrative operations and initial site setup
DB_ROOT_PASSWORD=change_this_root_password
# Database user password (fallback if DB_ROOT_PASSWORD is unset)
DB_PASSWORD=change_this_root_password
DB_HOST=db
DB_PORT=3306

# Frappe Administrator Account (used during bench new-site)
ADMIN_PASSWORD=change_this_admin_password

# Redis Configuration
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379
