# ERPNext All-in-One Configuration
ERPNEXT_VERSION=v16
CUSTOM_IMAGE=amirul123/allinone-erpnext
CUSTOM_TAG=latest

# Database
DB_PASSWORD=change_this_admin_password
DB_HOST=db
DB_PORT=3306

# Redis
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# Site / Networking
FRAPPE_SITE_NAME_HEADER=yoursite.local
HTTP_PORT=8080